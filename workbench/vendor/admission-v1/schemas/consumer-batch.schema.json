{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consumer-assessment-batch/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "consumer-assessment-batch/1"
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "sharedContext": {
      "$ref": "#/$defs/context"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "material"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "material": {},
          "context": {
            "$ref": "#/$defs/context"
          }
        }
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "expectedRepresentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "exceptionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
