{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Explicit model-neutral demonstration corpus",
 "type":"object","additionalProperties":false,
 "required":["schemaVersion","purpose","examples"],
 "properties":{
  "schemaVersion":{"const":"demonstration-corpus/1"},
  "purpose":{"const":"demonstrations"},
  "examples":{"type":"array","items":{
   "type":"object","additionalProperties":false,"required":["id","content","labels"],
   "properties":{
    "id":{"type":"string","minLength":1},"family":{"type":["string","null"]},
    "content":{"type":"object"},
    "labels":{"type":"object","additionalProperties":{"type":["string","boolean","number","null"]}}
   }
  }}
 }
}
