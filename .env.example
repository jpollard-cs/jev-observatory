# Jev's documented TypeSafe native API; only the key and current pricing are needed.
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/
JEV_MODEL=jev-latest
# Optional legacy alias JEV_API_KEY is accepted if TYPESAFE_API_KEY is not set.
# Independent OpenAI-compatible control API identities (Codex app access differs).
LUNA_BASE_URL=
LUNA_MODEL=
LUNA_API_KEY=
TERRA_BASE_URL=
TERRA_MODEL=
TERRA_API_KEY=
# Mandatory live-run pricing, in USD per million tokens, including worst-case tier.
# Official launch pricing, 2026-09-15: https://typesafe.ai/blog/introducing-system-one-models-and-jev
JEV_INPUT_USD_PER_MILLION=0.042
JEV_OUTPUT_USD_PER_MILLION=0
LUNA_INPUT_USD_PER_MILLION=
LUNA_OUTPUT_USD_PER_MILLION=
TERRA_INPUT_USD_PER_MILLION=
TERRA_OUTPUT_USD_PER_MILLION=
# Input char bytes are used as a conservative reservation, never reported as tokens.
# Control API field defaults to max_tokens; set max_completion_tokens if needed.
# Native Jev has NO documented configurable output-token limit.
LUNA_TOKEN_LIMIT_FIELD=max_tokens
TERRA_TOKEN_LIMIT_FIELD=max_tokens
# false: model-only JSON instructions. true is a SEPARATE constrained-output arm.
# Jev always uses its native constrained primitives, never arbitrary JSON generation.
LUNA_JSON_SCHEMA=false
TERRA_JSON_SCHEMA=false
PROMPTFOO_DISABLE_TELEMETRY=1
PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=true
